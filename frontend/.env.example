# Copia este fichero como .env.local y ajusta los valores. Nunca subas credenciales reales.

# URL base de la API de FastAPI (sin barra final).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Origen de los datos: "real" usa el backend; "mock" usa datos simulados en el navegador
# (necesario para la demo estática de GitHub Pages).
VITE_API_MODE=mock

# Ruta base desde la que se sirve la aplicación. "/" en local; "/Base_de_Batos/" en GitHub Pages.
VITE_BASE_PATH=/
